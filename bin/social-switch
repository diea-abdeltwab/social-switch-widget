#!/usr/bin/env bash
# social-switch
#
# Block/unblock social media sites system-wide via /etc/hosts.
# Each platform is independently blocked or allowed. The global on/off
# is a bulk action, not a separate mode:
#   sudo social-switch on   -> unblocks EVERY platform (all -> allowed)
#   sudo social-switch off  -> blocks EVERY platform (all -> blocked)
#   sudo social-switch block <platform>    -> block just that one
#   sudo social-switch unblock <platform>  -> allow just that one
#
# There's no separate "exclude" concept layered on top of a global
# mode — a platform's state is simply blocked or allowed, full stop,
# and that's exactly what's reflected in /etc/hosts and in `status`.
#
# Install:
#   chmod +x social-switch
#   sudo mv social-switch /usr/local/bin/social-switch
#
# Usage:
#   social-switch status                 -> show what's blocked / allowed
#   social-switch status --json          -> same, as machine-readable JSON
#   social-switch list                   -> list available platform keys
#   sudo social-switch on                -> unblock everything
#   sudo social-switch off               -> block everything
#   sudo social-switch off --except a,b  -> block everything except a, b
#   sudo social-switch block <n>...      -> block specific platform(s)
#   sudo social-switch unblock <n>...    -> allow specific platform(s)
#   social-switch doctor                 -> diagnose why blocking may not be working
#
# --json was added so a GUI front end (e.g. an Omarchy Quickshell bar
# widget) can poll status without root and without parsing the ANSI
# table. It's hand-rolled (no jq dependency) because every field comes
# from data this script already controls (fixed platform keys/labels),
# so there's nothing to escape beyond content we generated ourselves.

set -euo pipefail

HOSTS="/etc/hosts"
BACKUP="/etc/hosts.bak"
IP="0.0.0.0"

CONFIG_DIR="/etc/social-switch"
BLOCKED_FILE="$CONFIG_DIR/blocked"

BEGIN_MARK="# BEGIN social-switch managed block - do not edit below"
END_MARK="# END social-switch managed block"

PROG_NAME="$(basename "$0")"

if [ -t 1 ]; then
  C_RED=$'\033[1;31m'
  C_GREEN=$'\033[1;32m'
  C_YELLOW=$'\033[1;33m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BOLD=""; C_RESET=""
fi

# Platform key -> human label
declare -A PLATFORM_LABEL=(
  [facebook]="Facebook"
  [youtube]="YouTube"
  [instagram]="Instagram"
  [threads]="Threads"
  [twitter]="X / Twitter"
  [tiktok]="TikTok"
  [reddit]="Reddit"
  [snapchat]="Snapchat"
  [pinterest]="Pinterest"
  [kick]="Kick"
  [discord]="Discord"
  [twitch]="Twitch"
)

# Platform key -> domains (space-separated)
declare -A PLATFORM_DOMAINS=(
  [facebook]="facebook.com www.facebook.com m.facebook.com mbasic.facebook.com mobile.facebook.com fb.com www.fb.com"
  [youtube]="youtube.com www.youtube.com m.youtube.com youtu.be www.youtu.be music.youtube.com youtube-nocookie.com www.youtube-nocookie.com"
  [instagram]="instagram.com www.instagram.com"
  [threads]="threads.net www.threads.net"
  [twitter]="x.com www.x.com twitter.com www.twitter.com mobile.twitter.com tweetdeck.twitter.com"
  [tiktok]="tiktok.com www.tiktok.com m.tiktok.com vm.tiktok.com vt.tiktok.com"
  [reddit]="reddit.com www.reddit.com old.reddit.com new.reddit.com np.reddit.com amp.reddit.com"
  [snapchat]="snapchat.com www.snapchat.com web.snapchat.com"
  [pinterest]="pinterest.com www.pinterest.com pin.it"
  [kick]="kick.com www.kick.com player.kick.com files.kick.com"
  [discord]="discord.com www.discord.com discord.gg discordapp.com www.discordapp.com gateway.discord.gg cdn.discordapp.com media.discordapp.net"
  [twitch]="twitch.tv www.twitch.tv m.twitch.tv api.twitch.tv gql.twitch.tv player.twitch.tv clips.twitch.tv static.twitchcdn.net assets.twitch.tv"
)

# Fixed display order (bash associative arrays have no guaranteed order)
PLATFORM_ORDER=(youtube facebook instagram threads twitter tiktok reddit snapchat pinterest kick discord twitch)

require_root() {
  if [ "$EUID" -ne 0 ]; then
    echo "Error: this action needs root. Run: sudo $PROG_NAME ${1:-}"
    exit 1
  fi
}

is_valid_platform() {
  [ -n "${PLATFORM_LABEL[$1]+x}" ]
}

all_domains() {
  local key
  for key in "${PLATFORM_ORDER[@]}"; do
    echo "${PLATFORM_DOMAINS[$key]}"
  done
}

# --- blocked-set handling ---------------------------------------------
# BLOCKED_FILE is the single source of truth for which platforms are
# currently blocked — status reads THIS, not /etc/hosts, so there's no
# way for the two to drift apart the way grepping /etc/hosts directly
# could (a stray line, an interrupted write, a permission blip).
# /etc/hosts is a consequence of this file, not the other way around.

load_blocked() {
  BLOCKED=()
  if [ -f "$BLOCKED_FILE" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && BLOCKED+=("$line")
    done < "$BLOCKED_FILE"
  fi
  # Explicit success — see the old comment this carried: a `while
  # read` loop's own exit status is whatever its last-executed command
  # was, which can be 1 in edge cases, and since load_blocked is
  # called as a bare statement everywhere, `set -e` would silently
  # kill the whole script on that.
  return 0
}

save_blocked() {
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "${BLOCKED[@]}" > "$BLOCKED_FILE"
}

is_blocked_key() {
  local key="$1" b
  for b in "${BLOCKED[@]}"; do
    [ "$b" = "$key" ] && return 0
  done
  return 1
}

# --- /etc/hosts editing ------------------------------------------------

lock_hosts() {
  chattr -i "$HOSTS" 2>/dev/null || true
}

unlock_hosts_and_relock_on_exit() {
  trap 'chattr +i "$HOSTS" 2>/dev/null || true' EXIT
}

flush_dns() {
  if command -v resolvectl >/dev/null 2>&1; then
    resolvectl flush-caches 2>/dev/null || true
  elif command -v systemd-resolve >/dev/null 2>&1; then
    systemd-resolve --flush-caches 2>/dev/null || true
  fi
}

# Remove the managed block (matched by EXACT line equality via awk, no
# regex/escaping involved).
remove_block() {
  if grep -qF "$BEGIN_MARK" "$HOSTS" 2>/dev/null; then
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
      $0==b {skip=1; next}
      $0==e {skip=0; next}
      skip {next}
      {print}
    ' "$HOSTS" > "$HOSTS.tmp.$$" && mv "$HOSTS.tmp.$$" "$HOSTS"
  fi
}

# Strip ANY stray line for a known domain, anywhere in the file.
strip_stray_domain_lines() {
  local pattern_file="$CONFIG_DIR/.domains.$$"
  mkdir -p "$CONFIG_DIR"
  all_domains | tr ' ' '\n' | grep -v '^$' | sort -u > "$pattern_file"

  awk -v ip="$IP" 'BEGIN{
    while ((getline d < ARGV[1]) > 0) known[d]=1
    ARGV[1]=""
  }
  {
    split($0, f, /[ \t]+/)
    if (f[1]==ip && (f[2] in known)) next
    print
  }' "$pattern_file" "$HOSTS" > "$HOSTS.tmp.$$" && mv "$HOSTS.tmp.$$" "$HOSTS"

  rm -f "$pattern_file"
}

# Write a fresh managed block for exactly whatever's in $BLOCKED right now.
add_block() {
  local key domain
  {
    echo "$BEGIN_MARK"
    for key in "${BLOCKED[@]}"; do
      for domain in ${PLATFORM_DOMAINS[$key]}; do
        echo "$IP $domain"
      done
    done
    echo "$END_MARK"
  } >> "$HOSTS"
}

# Rewrites /etc/hosts to match $BLOCKED exactly. Call this after any
# change to $BLOCKED (on/off/block/unblock all funnel through here).
refresh_hosts() {
  lock_hosts
  unlock_hosts_and_relock_on_exit
  [ -f "$BACKUP" ] || cp "$HOSTS" "$BACKUP"

  remove_block
  strip_stray_domain_lines

  if [ "${#BLOCKED[@]}" -gt 0 ]; then
    add_block
  fi

  flush_dns
}

# --- JSON helpers ----------------------------------------------------------
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# --- commands ------------------------------------------------------------

cmd_on() {
  require_root "on"
  echo "Unblocking everything..."
  BLOCKED=()
  save_blocked
  refresh_hosts
  echo
  echo "${C_GREEN}${C_BOLD}Done. Everything is allowed.${C_RESET}"
}

cmd_off() {
  require_root "off"
  BLOCKED=("${PLATFORM_ORDER[@]}")

  # Optional: sudo social-switch off --except a,b,c
  if [ "${1:-}" = "--except" ] && [ -n "${2:-}" ]; then
    IFS=',' read -ra requested <<< "$2"
    local p new=() skip
    for p in "${BLOCKED[@]}"; do
      skip=0
      local r
      for r in "${requested[@]}"; do
        r="$(echo "$r" | tr -d '[:space:]')"
        [ "$p" = "$r" ] && skip=1
      done
      [ "$skip" -eq 0 ] && new+=("$p")
    done
    BLOCKED=("${new[@]}")
  fi

  echo "Blocking everything..."
  save_blocked
  refresh_hosts
  echo
  echo "${C_RED}${C_BOLD}Done. Everything is blocked.${C_RESET}"
  echo "Backup of the original /etc/hosts: $BACKUP"
  echo
  echo "${C_YELLOW}Note:${C_RESET} browsers with Secure DNS / DNS-over-HTTPS enabled (common"
  echo "default in Firefox, and available in Chrome) can bypass /etc/hosts entirely."
  echo "Run '$PROG_NAME doctor' to check, or disable Secure DNS in the browser."
}

cmd_block() {
  require_root "block <platform>"
  [ "$#" -ge 1 ] || { echo "Usage: sudo $PROG_NAME block <platform> [platform...]"; exit 1; }
  load_blocked
  local p changed=0
  for p in "$@"; do
    if ! is_valid_platform "$p"; then
      echo "${C_YELLOW}Unknown platform '$p', skipping. See '$PROG_NAME list'.${C_RESET}"
      continue
    fi
    if is_blocked_key "$p"; then
      echo "'$p' is already blocked."
    else
      BLOCKED+=("$p")
      echo "Blocking '$p'."
      changed=1
    fi
  done
  save_blocked
  [ "$changed" -eq 1 ] && refresh_hosts
}

cmd_unblock() {
  require_root "unblock <platform>"
  [ "$#" -ge 1 ] || { echo "Usage: sudo $PROG_NAME unblock <platform> [platform...]"; exit 1; }
  load_blocked
  local p changed=0 new=()
  for p in "${BLOCKED[@]}"; do
    local drop=0 arg
    for arg in "$@"; do
      [ "$p" = "$arg" ] && { drop=1; changed=1; echo "Unblocking '$p'."; }
    done
    [ "$drop" -eq 0 ] && new+=("$p")
  done
  BLOCKED=()
  if [ "${#new[@]}" -gt 0 ]; then
    BLOCKED=("${new[@]}")
  fi
  save_blocked
  [ "$changed" -eq 1 ] && refresh_hosts
}

# Shared status computation, reading straight from $BLOCKED_FILE — the
# single source of truth. Populates:
#   STATUS_KEYS=()      platform keys, in display order
#   STATUS_STATE[$key]  "blocked" | "allowed"
#   STATUS_BLOCKED_COUNT
compute_status() {
  load_blocked
  STATUS_KEYS=("${PLATFORM_ORDER[@]}")
  declare -gA STATUS_STATE=()
  STATUS_BLOCKED_COUNT=0

  local key
  for key in "${PLATFORM_ORDER[@]}"; do
    if is_blocked_key "$key"; then
      STATUS_STATE[$key]="blocked"
      ((++STATUS_BLOCKED_COUNT))
    else
      STATUS_STATE[$key]="allowed"
    fi
  done
}

cmd_status() {
  if [ "${1:-}" = "--json" ]; then
    cmd_status_json
    return
  fi

  compute_status
  local total="${#PLATFORM_ORDER[@]}"

  echo "===== Social Media Block Status ====="
  printf "%-14s %-14s %s\n" "PLATFORM" "STATUS" "SAMPLE DOMAIN"

  local key sample st
  for key in "${STATUS_KEYS[@]}"; do
    sample="$(echo "${PLATFORM_DOMAINS[$key]}" | awk '{print $1}')"
    st="${STATUS_STATE[$key]}"
    case "$st" in
      blocked) printf "%-14s ${C_RED}%-14s${C_RESET} %s\n"    "${PLATFORM_LABEL[$key]}" "blocked" "$sample" ;;
      allowed) printf "%-14s ${C_GREEN}%-14s${C_RESET} %s\n"  "${PLATFORM_LABEL[$key]}" "allowed" "$sample" ;;
    esac
  done

  echo
  echo "$STATUS_BLOCKED_COUNT / $total platforms currently blocked."
}

# Machine-readable status for GUI front ends (e.g. the Quickshell bar
# widget). No root required — reads only $BLOCKED_FILE. Output shape:
# {
#   "state": "on|off",     "on" if nothing is blocked, "off" otherwise
#   "blocked_count": N,
#   "total": N,
#   "platforms": [
#     {"key":"facebook","label":"Facebook","status":"blocked|allowed"},
#     ...
#   ]
# }
cmd_status_json() {
  compute_status
  local total="${#PLATFORM_ORDER[@]}"
  local state="on"
  [ "$STATUS_BLOCKED_COUNT" -gt 0 ] && state="off"

  printf '{"state":"%s","blocked_count":%d,"total":%d,"platforms":[' \
    "$state" "$STATUS_BLOCKED_COUNT" "$total"

  local key first=1
  for key in "${STATUS_KEYS[@]}"; do
    [ "$first" -eq 1 ] && first=0 || printf ','
    printf '{"key":"%s","label":"%s","status":"%s"}' \
      "$(json_escape "$key")" "$(json_escape "${PLATFORM_LABEL[$key]}")" "${STATUS_STATE[$key]}"
  done

  printf ']}\n'
}

cmd_list() {
  echo "Available platform keys:"
  local key
  for key in "${PLATFORM_ORDER[@]}"; do
    printf "  %-12s %s\n" "$key" "${PLATFORM_LABEL[$key]}"
  done
}

cmd_doctor() {
  cmd_status
  echo
  echo "===== Sanity checks ====="
  echo "-- Duplicate entries in $HOSTS for blocked domains:"
  local dupes
  dupes="$(awk -v ip="$IP" '$1==ip {print $2}' "$HOSTS" 2>/dev/null | sort | uniq -c | awk '$1>1')"
  if [ -n "$dupes" ]; then
    echo "${C_YELLOW}$dupes${C_RESET}"
    echo "  Found duplicates — run 'sudo $PROG_NAME off' again to clean them up automatically."
  else
    echo "  none found"
  fi

  echo
  echo "-- OS-level resolution test (bypasses browser DNS-over-HTTPS):"
  local key sample
  for key in facebook instagram twitter tiktok; do
    sample="$(echo "${PLATFORM_DOMAINS[$key]}" | awk '{print $1}')"
    local result
    result="$(getent hosts "$sample" 2>/dev/null | awk '{print $1}' || echo "no-resolve")"
    if [ "$result" = "$IP" ]; then
      echo "  ${C_RED}$sample -> $IP (blocked at OS level)${C_RESET}"
    else
      echo "  ${C_GREEN}$sample -> ${result:-unresolved} (NOT blocked at OS level)${C_RESET}"
    fi
  done

  echo
  echo "-- Is /etc/hosts locked (immutable)?"
  if command -v lsattr >/dev/null 2>&1; then
    lsattr "$HOSTS" 2>/dev/null || echo "  (couldn't check — needs root or unsupported filesystem)"
  else
    echo "  lsattr not available"
  fi

  echo
  echo "${C_YELLOW}Important:${C_RESET} if the OS-level test above shows domains ARE blocked"
  echo "(resolve to $IP) but the sites still load in your browser, the browser is"
  echo "very likely using Secure DNS / DNS-over-HTTPS (DoH), which bypasses"
  echo "/etc/hosts completely and queries an encrypted DNS server directly."
  echo "  - Firefox: Settings -> Privacy & Security -> DNS over HTTPS -> Off"
  echo "  - Chrome:  Settings -> Privacy and security -> Security -> Use secure DNS -> Off"
  echo "This is a browser setting, not something this script can control."
}

usage() {
  echo "Usage: $PROG_NAME {status|list|on|off|block|unblock|doctor} ..."
  echo
  echo "  status [--json]             Show block status per platform (no root)"
  echo "  list                        List available platform keys (no root)"
  echo "  on                          Unblock EVERYTHING (needs sudo)"
  echo "  off [--except a,b,c]        Block EVERYTHING, optionally except some (needs sudo)"
  echo "  block <n>...                Block specific platform(s) (needs sudo)"
  echo "  unblock <n>...              Allow specific platform(s) (needs sudo)"
  echo "  doctor                      Diagnose duplicates / DoH bypass issues (no root)"
  echo
  echo "Examples:"
  echo "  sudo $PROG_NAME off --except discord,twitch"
  echo "  sudo $PROG_NAME block reddit tiktok"
  echo "  sudo $PROG_NAME unblock discord"
  echo "  $PROG_NAME status --json"
  echo "  $PROG_NAME doctor"
}

case "${1:-}" in
  status)
    shift
    cmd_status "$@"
    ;;
  list)
    cmd_list
    ;;
  on)
    cmd_on
    ;;
  off)
    shift
    cmd_off "$@"
    ;;
  block)
    shift
    cmd_block "$@"
    ;;
  unblock)
    shift
    cmd_unblock "$@"
    ;;
  doctor)
    cmd_doctor
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
